# Servidor
PORT=5000

# Base de datos MongoDB (local o Atlas).
# Local:  mongodb://127.0.0.1:27017/mas-diagnostico
# Atlas:  mongodb+srv://<usuario>:<contrasena>@cluster0.xxxxx.mongodb.net/mas-diagnostico
MONGODB_URI=mongodb+srv://<usuario>:<contrasena>@cluster0.xxxxx.mongodb.net/mas-diagnostico

# Número de WhatsApp del laboratorio en formato internacional, sin + ni espacios
# Ej: 573146203073
WHATSAPP_NUMBER=573146203073

# --- WhatsApp Cloud API (opcional, para envío AUTOMÁTICO al laboratorio) ---
# Si no se configuran, el sistema guarda la cotización en MongoDB y devuelve
# un enlace wa.me para que el cliente envíe el mensaje directamente.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=

# Clave para consultar las cotizaciones registradas: GET /api/quotes con header X-Admin-Key
ADMIN_KEY=cambia-esta-clave

# --- Correo opcional (Nodemailer-style SMTP) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_TO=masdiagnosticolab@gmail.com